APP_NAME=ID Sports API
APP_ENV=development
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./id_sports.db
# PostgreSQL: postgresql+psycopg://postgres:PASSWORD@127.0.0.1:5432/id_sports
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:*
SMS_PROVIDER=twilio
SMS_COUNTRY_CODE=91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
